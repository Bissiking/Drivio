{
  "name": "drivio",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:migrate": "cross-env RUST_LOG=info prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:migrate:postgres": "cross-env RUST_LOG=info prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "db:validate:postgres": "prisma validate --schema prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "1.2.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.2.2",
    "geist": "1.5.1",
    "jose": "6.1.0",
    "lucide-react": "0.542.0",
    "next": "16.3.3",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.2.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "cross-env": "10.0.0",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
