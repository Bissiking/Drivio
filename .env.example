# .env.example
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3019"
SESSION_SECRET="change-me-with-at-least-32-random-characters"

# Kyros SSO v4
KYROS_BASE_URL="http://localhost:4000"
KYROS_ISSUER="kyros"
KYROS_CLIENT_ID="drivio-local"
KYROS_CLIENT_SECRET=""
KYROS_AUDIENCE="kyros-modules"
KYROS_RESOURCE_AUDIENCE="kyros:drivio"
KYROS_SCOPES="profile email offline_access"

# Seed: doit correspondre au sub du compte Kyros utilise en developpement.
KYROS_DEMO_SUB="demo-matheo"

# Documents privés (volume persistant hors public/)
DRIVIO_DOCUMENT_DIR="./storage/documents"
# Token par utilisateur saisi dans les paramètres et chiffré avec SESSION_SECRET.
GOTIFY_URL="https://notify.mhemery.fr"
