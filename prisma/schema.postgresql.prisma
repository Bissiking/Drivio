// prisma/schema.postgresql.prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id @default(cuid())
  kyrosSubject           String                 @unique
  email                  String?                @unique
  name                   String?
  avatarUrl              String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  vehicles               Vehicle[]
  notificationSettings   NotificationSettings?
  notificationDeliveries NotificationDelivery[]
  autoFuelMobile         Boolean                @default(false)
  autoFuelDesktop        Boolean                @default(false)
  fuelPromptClaims       FuelPromptClaim[]
}

model Vehicle {
  id                String                @id @default(cuid())
  userId            String
  brand             String
  model             String
  trim              String
  powertrain        String?
  drivetrain        String                @default("UNKNOWN")
  year              Int
  registration      String?
  vin               String?
  purchaseDate      DateTime
  purchaseMileage   Int
  purchasePrice     Decimal?
  saleDate          DateTime?
  finalMileage      Int?
  salePrice         Decimal?
  status            String                @default("ACTIVE")
  isPrimary         Boolean               @default(false)
  photoPath         String?
  photoUrl          String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mileageReadings   MileageReading[]
  maintenance       MaintenanceRecord[]
  schedules         MaintenanceSchedule[]
  expenses          Expense[]
  fuelEntries       FuelEntry[]
  warranties        Warranty[]
  inspections       TechnicalInspection[]
  insurancePolicies InsurancePolicy[]
  documents         VehicleDocument[]
  tireSets          TireSet[]

  @@index([userId, status])
  @@index([userId, isPrimary])
}

model MileageReading {
  id                   String      @id @default(cuid())
  vehicleId            String
  mileage              Int
  date                 DateTime
  comment              String?
  source               String      @default("MANUAL")
  fuelEntries          FuelEntry[]
  isCorrection         Boolean     @default(false)
  distanceFromPrevious Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  vehicle              Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@index([vehicleId, mileage])
}

model MaintenanceRecord {
  expense   Expense?
  id        String   @id @default(cuid())
  vehicleId String
  type      String
  title     String
  date      DateTime
  mileage   Int?
  cost      Decimal?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@index([vehicleId, type])
}

model MaintenanceSchedule {
  id                String    @id @default(cuid())
  vehicleId         String
  type              String
  title             String
  dueDate           DateTime?
  dueMileage        Int?
  warningDays       Int       @default(30)
  warningKm         Int       @default(1500)
  notes             String?
  provenance        String    @default("USER")
  reference         String?
  estimatedCost     Decimal?
  cycleStartDate    DateTime?
  cycleStartMileage Int?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, completedAt, dueDate])
  @@index([vehicleId, completedAt, dueMileage])
}

model Expense {
  fuelEntryId         String?            @unique
  maintenanceRecordId String?            @unique
  fuelEntry           FuelEntry?         @relation(fields: [fuelEntryId], references: [id], onDelete: SetNull)
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)
  id                  String             @id @default(cuid())
  vehicleId           String
  category            String
  amount              Decimal
  date                DateTime
  mileage             Int?
  comment             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@index([vehicleId, category])
}

model FuelEntry {
  mileageReadingId      String?
  mileageReading        MileageReading? @relation(fields: [mileageReadingId], references: [id], onDelete: SetNull)
  expense               Expense?
  id                    String          @id @default(cuid())
  vehicleId             String
  date                  DateTime
  mileage               Int
  liters                Decimal
  totalPrice            Decimal
  unitPrice             Decimal
  isFull                Boolean         @default(true)
  distanceSincePrevious Int?
  consumptionPer100Km   Decimal?
  costPer100Km          Decimal?
  stationId             String?
  fuelType              String?
  station               FuelStation?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
  @@index([vehicleId, mileage])
}

model Warranty {
  id         String   @id @default(cuid())
  vehicleId  String
  title      String
  type       String
  startDate  DateTime
  endDate    DateTime
  maxMileage Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, endDate])
}

model TechnicalInspection {
  id               String    @id @default(cuid())
  vehicleId        String
  date             DateTime
  nextDate         DateTime
  result           String
  requiresFollowUp Boolean   @default(false)
  followUpDeadline DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

model InsurancePolicy {
  id                String   @id @default(cuid())
  vehicleId         String
  company           String
  contractReference String?
  startDate         DateTime
  renewalDate       DateTime
  cost              Decimal?
  frequency         String   @default("MONTHLY")
  includeInCosts    Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate])
}

model VehicleDocument {
  id           String   @id @default(cuid())
  vehicleId    String
  title        String
  category     String
  date         DateTime
  description  String?
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

model TireSet {
  id              String            @id @default(cuid())
  vehicleId       String
  brand           String
  model           String?
  dimensions      String
  type            String
  position        String
  quality         String            @default("UNKNOWN")
  mountedAt       DateTime
  mountedMileage  Int
  removedAt       DateTime?
  removedMileage  Int?
  notes           String?
  targetDepthMm   Decimal?
  replacementCost Decimal?
  estimatedLifeKm Int?
  measurements    TireMeasurement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, mountedAt])
}

model TireMeasurement {
  id           String   @id @default(cuid())
  tireSetId    String
  date         DateTime
  mileage      Int
  treadDepthMm Decimal
  createdAt    DateTime @default(now())
  tireSet      TireSet  @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  @@unique([tireSetId, date])
  @@index([tireSetId, mileage])
}

model FuelPromptClaim {
  sessionId String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model FuelStation {
  id                    String             @id
  address               String
  city                  String
  postalCode            String
  searchText            String             @default("")
  latitude              Float?
  longitude             Float?
  active                Boolean            @default(true)
  lastSeenAt            DateTime
  missingSince          DateTime?
  fingerprint           String
  availabilityUncertain Boolean            @default(false)
  prices                FuelPrice[]
  history               FuelPriceHistory[]
  outages               FuelOutage[]
  fuelEntries           FuelEntry[]

  @@index([active, postalCode])
  @@index([active, latitude, longitude])
}

model FuelPrice {
  stationId  String
  fuelId     String
  value      Decimal
  declaredAt DateTime
  active     Boolean     @default(true)
  station    FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, fuelId])
}

model FuelPriceHistory {
  id         String      @id @default(cuid())
  stationId  String
  fuelId     String
  value      Decimal
  declaredAt DateTime
  observedAt DateTime
  station    FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, fuelId, declaredAt, value])
  @@index([stationId, fuelId, declaredAt])
}

model FuelOutage {
  id        String      @id @default(cuid())
  stationId String
  fuelId    String
  startedAt DateTime
  endedAt   DateTime?
  type      String
  endSource String?
  station   FuelStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, fuelId, startedAt])
  @@index([stationId, endedAt])
}

// Single coordination row, never an Aion execution-history database.
model FuelSyncState {
  id           String    @id
  leaseOwner   String?
  leaseUntil   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  status       String    @default("NEVER")
  snapshotHash String?
  stationCount Int       @default(0)
  statsJson    String?
  error        String?
}

model NotificationSettings {
  enabledTypes   String   @default("maintenanceSoon,maintenanceOverdue,maintenanceMileage,warrantySoon,warrantyExpired,inspectionSoon,inspectionOverdue,insurance")
  id             String   @id @default(cuid())
  userId         String   @unique
  enabled        Boolean  @default(false)
  maintenance    Boolean  @default(true)
  warranty       Boolean  @default(true)
  inspection     Boolean  @default(true)
  insurance      Boolean  @default(true)
  warningDays    Int      @default(30)
  warningKm      Int      @default(1500)
  tokenEncrypted String?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id        String    @id @default(cuid())
  userId    String
  key       String
  sentAt    DateTime?
  claimedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
